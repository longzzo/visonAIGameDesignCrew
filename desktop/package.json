{
  "name": "vision-engine-desktop",
  "version": "3.4.2",
  "private": true,
  "description": "Vision Engine — 게임 개발 멀티에이전트 스튜디오 (데스크톱 셸)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "predist": "npm --prefix ../webapp run build:studio && node ../webapp/scripts/prepare-desktop-runtime.mjs",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.visionengine.desktop",
    "productName": "Vision Engine",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.html",
      "tray-icon.png"
    ],
    "extraResources": [
      { "from": "../webapp/dist", "to": "vision-engine/webapp/dist" },
      { "from": "../webapp/dist-server", "to": "vision-engine/webapp/dist-server" },
      { "from": "../webapp/.desktop-runtime/node_modules", "to": "vision-engine/webapp/node_modules" },
      { "from": "../webapp/public", "to": "vision-engine/webapp/public" },
      { "from": "../webapp/assets", "to": "vision-engine/webapp/assets" },
      { "from": "../agents", "to": "vision-engine/agents", "filter": ["**/AGENTS.md"] },
      { "from": "../config", "to": "vision-engine/config", "filter": ["agents.manifest.json", "execution-policy.json", "mcp.json", "model-policy.json", "openclaw.json"] },
      { "from": "../scripts", "to": "vision-engine/scripts", "filter": ["setup-openclaw.mjs", "sync-agent-manifest.mjs"] },
      { "from": "../templates", "to": "vision-engine/templates" }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vision Engine",
      "runAfterFinish": true,
      "artifactName": "VisionEngine-Setup-${version}.${ext}"
    }
  }
}
