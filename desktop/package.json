{
  "name": "vision-engine-desktop",
  "version": "4.2.3",
  "private": true,
  "description": "Vision Engine — 게임 개발 멀티에이전트 스튜디오 (데스크톱 셸)",
  "author": "Vision Engine",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "predist": "npm --prefix ../webapp run build:studio && node ../webapp/scripts/prepare-desktop-runtime.mjs && node ../scripts/generate-third-party-notices.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "release:check": "node ../scripts/release-check.mjs --strict",
    "dist:release": "npm run release:check && npm run dist"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.visionengine.desktop",
    "productName": "Vision Engine",
    "copyright": "Copyright © 2026 Vision Engine",
    "asar": true,
    "afterPack": "scripts/harden-electron-fuses.mjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/longzzo/visonAIGameDesignCrew/releases/latest/download/"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.html",
      "tray-icon.png"
    ],
    "extraResources": [
      {
        "from": "../webapp/dist",
        "to": "vision-engine/webapp/dist"
      },
      {
        "from": "../webapp/dist-server",
        "to": "vision-engine/webapp/dist-server"
      },
      {
        "from": "../webapp/.desktop-runtime/node_modules",
        "to": "vision-engine/webapp/node_modules"
      },
      {
        "from": "../webapp/public",
        "to": "vision-engine/webapp/public"
      },
      {
        "from": "../webapp/assets",
        "to": "vision-engine/webapp/assets"
      },
      {
        "from": "../agents",
        "to": "vision-engine/agents",
        "filter": [
          "**/AGENTS.md"
        ]
      },
      {
        "from": "../config",
        "to": "vision-engine/config",
        "filter": [
          "agents.manifest.json",
          "execution-policy.json",
          "mcp.json",
          "model-policy.json",
          "openclaw.json",
          "product.json"
        ]
      },
      {
        "from": "EULA.txt",
        "to": "legal/EULA.txt"
      },
      {
        "from": "../PRIVACY.md",
        "to": "legal/PRIVACY.md"
      },
      {
        "from": "../SECURITY.md",
        "to": "legal/SECURITY.md"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "legal/THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../scripts",
        "to": "vision-engine/scripts",
        "filter": [
          "setup-openclaw.mjs",
          "migrate-openclaw-secrets.mjs",
          "openclaw-merge.mjs",
          "sync-agent-manifest.mjs"
        ]
      },
      {
        "from": "../templates",
        "to": "vision-engine/templates"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vision Engine",
      "runAfterFinish": true,
      "license": "EULA.txt",
      "artifactName": "VisionEngine-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2"
  }
}
