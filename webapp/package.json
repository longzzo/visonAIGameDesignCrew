{
  "name": "vision-engine-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vision Engine — 게임 기획 멀티에이전트 웹앱 (OpenClaw 게이트웨이 프론트엔드)",
  "scripts": {
    "sync:agents": "node ../scripts/sync-agent-manifest.mjs",
    "predev": "node scripts/prepare-env.mjs",
    "dev": "vite",
    "dev:mobile": "node scripts/prepare-env.mjs && node scripts/dev-mobile.mjs",
    "prebuild": "node scripts/prepare-env.mjs",
    "build": "vite build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:studio": "npm run build && npm run build:runtime",
    "runtime": "node dist-server/runtime.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "check": "npm run sync:agents && tsc --noEmit -p tsconfig.json && npm test && npm run build:studio && npm run test:runtime",
    "preview": "vite preview"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.2",
    "@openai/codex-sdk": "^0.147.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "connect": "^3.7.0",
    "dompurify": "^3.1.6",
    "marked": "^12.0.2",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sirv": "^3.0.2",
    "tesseract.js": "^7.0.0",
    "three": "^0.169.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.0",
    "@types/connect": "^3.4.38",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
